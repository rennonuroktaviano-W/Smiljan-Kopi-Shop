# Salin file ini menjadi `.env.local` lalu isi nilai sesuai bisnis.
# Nilai kosong = CTA pesanan/kunjungan dinonaktifkan dengan pesan yang jelas.

# Nomor WhatsApp pemesanan dalam format internasional TANPA tanda +, spasi,
# atau tanda hubung. Contoh: 62812xxxxxxx
# Biarkan kosong selama nomor resmi belum diberikan pemilik.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Nama/tujuan yang ditampilkan pada pesan WhatsApp.
NEXT_PUBLIC_BUSINESS_NAME=Smiljan Kopi Shop

# Nama area/kota untuk metadata sederhana (opsional).
NEXT_PUBLIC_BUSINESS_AREA=

# URL icon-app/logo hanya jika tersedia.
NEXT_PUBLIC_SITE_URL=https://smiljan.example.com

# Social media hanya jika URL valid sudah diberikan.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Alamat dan tautan Google Maps hanya jika lokasi terverifikasi.
NEXT_PUBLIC_ADDRESS_LINE_1=
NEXT_PUBLIC_ADDRESS_LINE_2=
NEXT_PUBLIC_MAPS_URL=

# Setel ke true hanya setelah seluruh data bisnis di atas diverifikasi pemilik.
# Saat false, halaman menu/kunjungan menampilkan pesan bahwa data belum final.
NEXT_PUBLIC_BUSINESS_INFO_READY=false

# Token beacon Cloudflare Web Analytics (Analytics & Logs → Web Analytics →
# Add site → mode "JS snippet"). Analytics agregat tanpa cookie; biarkan
# kosong untuk menonaktifkan analytics sepenuhnya. Token ini memang publik,
# bukan rahasia — jangan pernah menaruh nilai rahasia di NEXT_PUBLIC_*.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Admin CMS (server-side saja — JANGAN beri prefix NEXT_PUBLIC_*) ---

# String koneksi Postgres produksi (Neon pooled connection string).
# Wajib di produksi. Contoh:
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Rahasia Auth.js v5. Buat dengan `npx auth secret` atau `openssl rand -base64 32`.
AUTH_SECRET=

# URL kanonik situs untuk redirect & cookie. Opsional di dev; wajib di produksi.
AUTH_URL=

# Akun pemilik (owner) awal. Dipakai oleh `npm run create-owner` dan `npm run db:prepare`.
# Kata sandi minimal 10 karakter. JANGAN pernah commit nilai sebenarnya.
OWNER_NAME=Smiljan Owner
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Hanya untuk pengembangan lokal (JANGAN disetel di produksi) ---
# Setel ALLOW_LOCAL_DB=1 untuk memakai PGlite (Postgres embedded, tanpa Neon).
ALLOW_LOCAL_DB=
PGLITE_DIR=./.data/pglite